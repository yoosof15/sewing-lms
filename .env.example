APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Local-only initial administrator. Used only by LocalAdminSeeder.
LOCAL_ADMIN_FIRST_NAME=
LOCAL_ADMIN_LAST_NAME=
LOCAL_ADMIN_MOBILE=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

VIDEO_STORAGE_DRIVER=local
VIDEO_MAX_UPLOAD_MB=10240
VIDEO_UPLOAD_CHUNK_MB=5
VIDEO_UPLOAD_SESSION_TTL_HOURS=24
VIDEO_PROCESSOR_DRIVER=ffmpeg
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_TARGET_MAX_WIDTH=1920
VIDEO_TARGET_MAX_HEIGHT=1080
VIDEO_TARGET_MAX_FPS=30
VIDEO_VIDEO_CODEC=libx264
VIDEO_AUDIO_CODEC=aac
VIDEO_CRF=22
VIDEO_PRESET=medium
VIDEO_KEEP_ORIGINAL=true
VIDEO_PROCESSING_MAX_ATTEMPTS=3
VIDEO_PROCESSING_TIMEOUT=7200
VIDEO_PROCESSING_TEMP_PATH=
VIDEO_PROCESSING_DISK_OVERHEAD=1.25
DB_QUEUE_RETRY_AFTER=7500
VIDEO_PROGRESS_HEARTBEAT_SECONDS=12
VIDEO_PROGRESS_MAX_RATE=2
VIDEO_PROGRESS_CREDIT_TOLERANCE_SECONDS=3
VIDEO_WATERMARK_ENABLED=true
VIDEO_WATERMARK_MOVE_SECONDS=30
AUTH_MAX_ACTIVE_SESSIONS=2
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
